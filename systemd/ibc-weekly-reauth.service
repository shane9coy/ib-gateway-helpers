[Unit]
Description=Open the trading week: start IB Gateway and prompt for the weekly IBKR re-auth

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/USER/ibc/notify_weekly_reauth.sh
# The script starts the gateway and waits for the 2FA prompt to appear.
TimeoutStartSec=180
